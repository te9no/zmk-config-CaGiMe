if SHIELD_CGM_LEFT || SHIELD_CGM_RIGHT

config ZMK_ZEROSHIFT
    default y if !ZMK_SETTINGS_RESET_ON_START

config ZMK_ZEROSHIFT_SLOT_COUNT
    default 2

config ZMK_ZEROSHIFT_SETTINGS_SUBTREE
    default "cagime"

config ZMK_ZEROSHIFT_SETTINGS_KEY
    default "modules-v1"

config ZMK_SPLIT
    default y

config ZMK_KEYBOARD_NAME
    default "CaGiMe"

if SHIELD_CGM_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

endif
endif

if SHIELD_CGM_RIGHT || SHIELD_CGM_LEFT

config ADC_ADS1220
    default y

config INPUT_ANALOG_AXIS_HIRES_SETTINGS
    default n

config INPUT_ANALOG_AXIS_HIRES_THREAD_STACK_SIZE
    default 2048

config INPUT_ANALOG_AXIS_HIRES_THREAD_PRIORITY
    default 9

config PM_DEVICE
    default y

endif
